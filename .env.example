# Public URL where the app is reachable. Used to build redirect URIs and (in
# production) the client_id and jwks_uri. For local dev, leave as 127.0.0.1.
PUBLIC_URL=http://127.0.0.1:5173

# 32+ random bytes (base64url). Used to sign the `did` session cookie.
# Generate with: `npm run generate-jwks` (which prints all required env values).
COOKIE_SECRET=

# Three ES256 private JWKs, JSON-encoded on a single line. Generate with
# `npm run generate-jwks`. Keep these out of version control.
PRIVATE_JWK_1=
PRIVATE_JWK_2=
PRIVATE_JWK_3=
